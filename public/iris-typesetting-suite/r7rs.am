distclean-local::
	-rm -R -f ${builddir}/r7rs

install-data-local::
	(cd $(builddir)/r7rs && \
		find . -type d \
			-exec ${MKDIR_P} $(DESTDIR)${gauche_sitelibdir}/{} ';')
	(cd $(builddir)/r7rs && \
		find . -name '*.sld' \
			-exec cp {} $(DESTDIR)${gauche_sitelibdir}/{} ';')

uninstall-local::
	-rm -rf $(DESTDIR)${gauche_sitelibdir}

