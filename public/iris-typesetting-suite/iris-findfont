#!/usr/bin/env -S gosh -r7 -I ./r7rs
;;; iris-findfont --- Iris font lookup command-line tool
;;;
;;; SPDX-License-Identifier: MIT

(import (scheme base)
        (scheme process-context)
        (scheme write)
        (gauche base)
        (iris db)
        (iris db builder)
        (iris db suggest))

(define (get-font-record-by-id db id-str)
  (let* ((rec-key (string-append "font:" id-str))
         (rec-str (db-get db rec-key #f)))
    (if rec-str
        (read-from-string rec-str)
        #f)))

(define (lookup-id-by-prefix db pre query)
  (let* ((k (string-append pre query))
         (id-str (db-get db k #f)))
    id-str))

(define (find-font-in-db db query)
  (let ((id-str (or (lookup-id-by-prefix db "ps:" query)
                    (lookup-id-by-prefix db "full:" query)
                    (lookup-id-by-prefix db "fam:" query)
                    (lookup-id-by-prefix db "file:" query))))
    (if id-str
        (let ((rec (get-font-record-by-id db id-str)))
          (if rec (list rec) '()))
        '())))

(define (handle-missing-font db query)
  (let ((suggestions (suggest-similar-names db query 3)))
    (display (string-append "Font not found: " query "\n"))
    (unless (null? suggestions)
      (display (format-did-you-mean-diagnostic suggestions))
      (newline))))

(define (process-query db query)
  (let ((found (find-font-in-db db query)))
    (if (not (null? found))
        (begin
          (write (car found))
          (newline))
        (handle-missing-font db query))))

(define (main args)
  (let ((queries (cdr args)))
    (if (null? queries)
        (begin
          (display "Usage: iris-findfont <font-query> ...\n")
          1)
        (let* ((db-path (default-fonts-db-path))
               (db (if (file-exists? db-path)
                       (db-open db-path 'read)
                       #f)))
          (if (not db)
              (begin
                (display "Error: fonts database not found at ")
                (display db-path)
                (newline)
                1)
              (begin
                (for-each (lambda (q) (process-query db q)) queries)
                (db-close db)
                0))))))

(main (command-line))

