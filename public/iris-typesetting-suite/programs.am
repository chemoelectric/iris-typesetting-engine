iris$(EXEEXT): iris.lo libiris.la
	$(call link-ada,$(basename $(@)),$(^),$(LIBS))

bin_PROGRAMS += iris
iris_SOURCES =
iris_SOURCES += iris.adb
iris_LDADD =
iris_LDADD += .libs/iris.$(OBJEXT)
iris_LDADD += libiris.la
iris_DEPENDENCIES =
iris_DEPENDENCIES += iris.lo
iris_DEPENDENCIES += libiris.la

CLEANFILES += iris$(EXEEXT)

