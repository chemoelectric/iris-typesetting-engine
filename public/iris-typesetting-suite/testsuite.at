AT_INIT
AT_COPYRIGHT([Copyright © 2026 Barry Schwartz])

AT_SETUP([capypdf])
AT_KEYWORDS([capypdf])
AT_CHECK(["${abs_builddir}"/test_capypdf | ${SED} '/^summary/s/^.*\([[0-9]]\+\) *failed.*$/\1/p;d'],[0],[0
])
AT_CLEANUP

AT_SETUP([Gauche binding])
AT_KEYWORDS([Gauche Scheme binding])
AT_CHECK(["${abs_builddir}"/test_gauche_binding])
AT_CLEANUP

AT_SETUP([Tkrzw binding])
AT_KEYWORDS([Tkrzw binding])
AT_CHECK(["${abs_builddir}"/test_tkrzw])
AT_CLEANUP

