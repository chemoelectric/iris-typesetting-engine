AT_INIT
AT_COPYRIGHT([Copyright © 2026 Barry Schwartz])

AT_SETUP([pdf])
AT_KEYWORDS([pdf capypdf])
AT_CHECK(["${abs_builddir}"/test_pdf_01],[0],[ignore],[ignore])
AT_CLEANUP

AT_SETUP([font_finders])
AT_KEYWORDS([font_finders fonts])
AT_CHECK(["${abs_builddir}"/test_find_main_system_fonts],[0],
         [ignore],[ignore])
AT_CHECK(["${abs_builddir}"/test_find_tex_fonts],[0],
         [ignore],[ignore])
AT_CLEANUP

AT_SETUP([sexpressions])
AT_KEYWORDS([sexpr r7rs sexpr s-expression sexp scheme lisp])
AT_CHECK(["${abs_builddir}"/test_sexpressions],[0],[ignore],[ignore])
AT_CLEANUP

