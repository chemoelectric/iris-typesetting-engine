#---------------------------------------------------------------------

AT_INIT
AT_COPYRIGHT([Copyright © 2026 Barry Schwartz])

#---------------------------------------------------------------------
AT_BANNER([document formats])

AT_SETUP([pdf])
AT_KEYWORDS([pdf capypdf])
AT_CHECK(["${abs_builddir}"/test_pdf_01],[0],[ignore],[ignore])
AT_CLEANUP

#---------------------------------------------------------------------
AT_BANNER([fonts])

AT_SETUP([font_finders])
AT_KEYWORDS([font_finders fonts])
AT_CHECK(["${abs_builddir}"/test_find_main_system_fonts],[0],
         [ignore],[ignore])
AT_CHECK(["${abs_builddir}"/test_find_tex_fonts],[0],
         [ignore],[ignore])
AT_CLEANUP

#---------------------------------------------------------------------
AT_BANNER([s-expressions, json, xml, etc.])

AT_SETUP([sexpressions])
AT_KEYWORDS([sexpr r7rs sexpr s-expression sexp scheme lisp])
AT_CHECK(["${abs_builddir}"/test_sexpressions],[0],[ignore],[ignore])
AT_CLEANUP

m4_define([m4_test_sexpr_equal],
  ["${abs_builddir}"/test_sexpressions_equal [$1] [$2] | tr -d '\n\r'])
AT_SETUP([sexpressions_equal])
AT_KEYWORDS([sexpr r7rs sexpr s-expression sexp scheme lisp equal])
AT_CHECK([m4_test_sexpr_equal([\#f],[\#f])],[0],[1])
AT_CHECK([m4_test_sexpr_equal([\#f],[\#false])],[0],[1])
AT_CHECK([m4_test_sexpr_equal([\#t],[\#t])],[0],[1])
AT_CHECK([m4_test_sexpr_equal([\#t],[\#true])],[0],[1])
AT_CHECK([m4_test_sexpr_equal([\#f],[\#t])],[0],[0])
AT_CHECK([m4_test_sexpr_equal([\#true],[\#false])],[0],[0])
AT_CHECK([m4_test_sexpr_equal([0],[1])],[0],[0])
AT_CHECK([m4_test_sexpr_equal([0],[0])],[0],[1])
AT_CHECK([m4_test_sexpr_equal([1],[1])],[0],[1])
AT_CHECK([m4_test_sexpr_equal([-0],[-1])],[0],[0])
AT_CHECK([m4_test_sexpr_equal([-0],[-0])],[0],[1])
AT_CHECK([m4_test_sexpr_equal([-1],[-1])],[0],[1])
AT_CHECK([m4_test_sexpr_equal([1],[1.0])],[0],[1])
AT_CLEANUP

