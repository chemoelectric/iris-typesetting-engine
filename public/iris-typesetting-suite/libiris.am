lib_LTLIBRARIES += libiris.la
libiris_la_SOURCES =
libiris_la_SOURCES += $(LIBIRIS_ADB_FILES)
libiris_la_SOURCES += $(LIBIRIS_ADS_FILES)
libiris_la_SOURCES += $(LIBIRIS_C_FILES)
libiris_la_LIBADD =
libiris_la_LIBADD += $(LIBIRIS_ADB_FILES:%.adb=.libs/%.$(OBJEXT))
libiris_la_LIBADD += $(LIBIRIS_ADS_FILES:%.ads=.libs/%.$(OBJEXT))
libiris_la_DEPENDENCIES =
libiris_la_DEPENDENCIES += $(LIBIRIS_ADB_FILES:%.adb=%.lo)
libiris_la_DEPENDENCIES += $(LIBIRIS_ADS_FILES:%.ads=%.lo)

