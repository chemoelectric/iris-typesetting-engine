check_PROGRAMS += test_capypdf
test_capypdf_SOURCES = test_capypdf.adb	
test_capypdf_SOURCES += $(test_capypdf_ADB)
test_capypdf_SOURCES += $(test_capypdf_ADS)
test_capypdf_SOURCES += $(test_capypdf_C)
test_capypdf_ADB = $(IRIS_ADB_COMMON)
test_capypdf_ADS = $(IRIS_ADS_COMMON)
test_capypdf_C = $(IRIS_ADS_COMMON)
test_capypdf_ADB += capypdf_tests.adb
test_capypdf_ADS += capypdf_tests.ads
TESTS_ADB += test_capypdf.adb
TESTS_ADB += capypdf_tests.adb
TESTS_ADS += capypdf_tests.ads
test_capypdf$(EXEEXT): \
		$(addsuffix .lo,$(basename $(test_capypdf_SOURCES)))
	$(call link-ada,test_capypdf,$(^),$(LIBS))

