TESTS_ADB += test_gauche_binding.adb
test_gauche_binding$(EXEEXT): \
		$(addsuffix .lo,$(basename $(test_gauche_binding_SOURCES)))
	$(call link-ada,test_gauche_binding,$(^),$(LIBS))

