check_PROGRAMS += test_gauche_binding
test_gauche_binding_SOURCES = test_gauche_binding.adb	
test_gauche_binding_SOURCES += $(test_gauche_binding_ADB)
test_gauche_binding_SOURCES += $(test_gauche_binding_ADS)
test_gauche_binding_SOURCES += $(test_gauche_binding_C)
test_gauche_binding_ADB = $(IRIS_ADB_COMMON)
test_gauche_binding_ADS = $(IRIS_ADS_COMMON)
