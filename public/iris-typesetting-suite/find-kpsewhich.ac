if test x"${ac_cv_env_KPSEWHICH_set}" = x"set"; then
  :
else
  AC_PATH_PROG([KPSEWHICH],[kpsewhich])
  if test x"${ac_cv_path_KPSEWHICH}" = x; then
    AC_MSG_WARN([-------------------------------------------------------------])
    AC_MSG_WARN([kpsewhich is missing. Consider installing TeXLive or similar.])
    AC_MSG_WARN([Using “/bin/false” as the kpsewhich executable.])
    AC_MSG_WARN([-------------------------------------------------------------])
    KPSEWHICH="/bin/false"
  else
    AC_DEFINE([HAVE_KPSEWHICH],[1],
          [Define to 1 if you have the kpsewhich executable])
    KPSEWHICH="${ac_cv_path_KPSEWHICH}"
  fi
fi
AC_ARG_VAR([KPSEWHICH],[kpsewhich executable for finding TeX files])

