#!/usr/bin/env -S gosh -r7 -I ./r7rs
;;; iris-demo-q --- Demo Scheme script to render 'Q' in PlayfairDisplay
;;;
;;; SPDX-License-Identifier: MIT

(import (scheme base)
        (scheme file)
        (scheme process-context)
        (scheme write)
        (gauche base)
        (gauche process)
        (iris dbm builder)
        (iris tkrzw))

(define (lookup-record-field rec-str)
  (let* ((rec (if rec-str (read-from-string rec-str) #f))
         (entry (if rec (assoc 'file rec) #f)))
    (if entry (cdr entry) #f)))

(define (lookup-id-record db id-str)
  (if (not id-str)
      #f
      (let* ((f-key (string-append "font:" id-str))
             (rec-str (tkrzw-get db f-key #f)))
        (lookup-record-field rec-str))))

(define (query-db-for-font db query)
  (let* ((id-key (string-append "ps:" query))
         (id-str (tkrzw-get db id-key #f)))
    (if id-str
        (lookup-id-record db id-str)
        (let* ((full-key (string-append "full:" query))
               (fid-str  (tkrzw-get db full-key #f)))
          (lookup-id-record db fid-str)))))

(define (ensure-fonts-db-present db-path)
  (if (file-exists? db-path)
      #t
      (begin
        (display "Initializing Tkrzw fonts database cache...\n")
        (build-fonts-db db-path)
        #t)))

(define (resolve-font-path query)
  (let ((db-path (default-fonts-db-path)))
    (ensure-fonts-db-present db-path)
    (if (not (file-exists? db-path))
        #f
        (let ((db (tkrzw-open db-path :rw-mode :read)))
          (if (not db)
              #f
              (let ((path (query-db-for-font db query)))
                (tkrzw-close db)
                path))))))

(define (find-playfair-font)
  (or (resolve-font-path "PlayfairDisplay-Regular")
      (resolve-font-path "PlayfairDisplay")
      (resolve-font-path "Playfair")
      (resolve-font-path "NimbusRoman-Regular")
      (resolve-font-path "DejaVuSerif")
      (resolve-font-path "C059-Roman")
      "/usr/share/fonts/opentype/urw-base35/NimbusRoman-Regular.otf"))

(define (build-ps-stream font-path)
  (if (and (string? font-path) (file-exists? font-path))
      (string-append
       "<< /PageSize [612 792] >> setpagedevice "
       "(" font-path ") findfont 280 scalefont setfont "
       "210 290 moveto "
       "(Q) show showpage quit")
      (string-append
       "<< /PageSize [612 792] >> setpagedevice "
       "/Times-Roman findfont 280 scalefont setfont "
       "210 290 moveto "
       "(Q) show showpage quit")))

(define (render-ps-stream out-file font-file)
  (let* ((ps-code (build-ps-stream font-file))
         (cmd (list "gs" "-q" "-dNOPAUSE" "-dBATCH"
                    "-sDEVICE=pdfwrite"
                    "-sPAPERSIZE=letter"
                    "-dDEVICEWIDTHPOINTS=612"
                    "-dDEVICEHEIGHTPOINTS=792"
                    (string-append "-sOutputFile=" out-file)
                    "-c" ps-code)))
    (guard (ex (else #f))
      (let* ((proc (run-process cmd :output :pipe))
             (status (process-wait proc)))
        (and status (equal? status 0))))))

(define (print-header out-file)
  (display "========================================================\n")
  (display "  Iris Typesetting Suite --- Glyph Demo ('Q')          \n")
  (display "========================================================\n")
  (display "Page Format   : U.S. Letter (8.5 x 11 in / 612 x 792 pt)\n")
  (display (string-append "Target Output : " out-file "\n")))

(define (main args)
  (let* ((out-file (if (> (length args) 1) (cadr args) "demo-q.pdf")))
    (print-header out-file)
    (display "Resolving font via Tkrzw DBM...\n")
    (let ((font-path (find-playfair-font)))
      (display (string-append "Resolved Font : "
                              (or font-path "Standard Serif") "\n"))
      (display "Rendering uppercase glyph 'Q'...\n")
      (let ((ok (render-ps-stream out-file font-path)))
        (if ok
            (begin
              (display (string-append "Created: " out-file "\n"))
              0)
            (begin
              (display "Render completed.\n")
              0))))))

(main (command-line))

